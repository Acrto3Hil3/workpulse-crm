# ============================================================
#  WorkPulse configuration — copy to .env and fill in.
#  Never commit .env. Restart the app after changing it.
# ============================================================

# ---------- App ----------
PORT=3000
APP_NAME=WorkPulse
# Shown under the logo on the login screen. Blank hides it.
APP_TAGLINE=Every task, tracked.
APP_TZ=Asia/Kolkata
# Public URL of the app — linked at the bottom of reminders/reports (optional).
APP_URL=
SESSION_SECRET=replace-with-a-long-random-string
SECURE_COOKIES=false   # set true once the site runs on HTTPS

# ---------- Database ----------
# OPTION A — one connection string (online/serverless databases). Recommended.
#   TiDB Cloud Starter (MySQL):  mysql://<prefix>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/test
#   Neon / Supabase (Postgres):  postgres://user:password@host/dbname?sslmode=require
# The engine is detected from the prefix (mysql:// or postgres://); cloud hosts are
# connected over TLS automatically. See README > "Choosing a database".
DATABASE_URL=
# Set true to also verify the server certificate (works with TiDB Cloud and Neon).
DB_SSL_VERIFY=false

# OPTION B — plain settings. Use these when DATABASE_URL is empty, or when the
# password contains characters that break a URL (@ / # :).
# For TiDB Cloud: DB_PORT=4000, DB_NAME=test, DB_SSL=true.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=workpulse
DB_USER=crm
DB_PASS=change-me
DB_SSL=false
DB_POOL=10

# ---------- First owner account (created on first boot only) ----------
ADMIN_NAME=Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=changeme123

# ============================================================
#  WHERE YOU RECEIVE REPORTS & ALERTS
#  The daily overdue report and the Sunday score summary are
#  delivered to these addresses. Comma-separate for several.
#  Leave empty to default to every owner account's email/phone.
# ============================================================
REPORT_EMAIL=you@yourcompany.com
REPORT_WHATSAPP=919876543210

# ============================================================
#  EMAIL SENDING (SMTP) — powers all email reminders/reports.
#  Empty SMTP_HOST = email channel off.
#  A Hostinger mailbox (hPanel > Emails) works directly:
#    SMTP_HOST=smtp.hostinger.com   SMTP_PORT=465
#    SMTP_USER=crm@your-domain.com  SMTP_PASS=mailbox-password
#  Testing: SMTP_HOST=json prints emails to the log, sends nothing.
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
#  WHATSAPP SENDING (Meta WhatsApp Cloud API) — powers automatic
#  WhatsApp reminders/reports. Both empty = WhatsApp channel off
#  (the manual 💬 buttons in the app keep working regardless).
#  Setup (~10 min, see README "WhatsApp setup"):
#    developers.facebook.com > create app > WhatsApp > API setup
#    WHATSAPP_TOKEN    = permanent access token
#    WHATSAPP_PHONE_ID = "Phone number ID" shown there
#  Free-form texts only reach people who messaged your business
#  number in the last 24h. For reminders that always deliver,
#  create an approved template with one {{1}} body variable and
#  set WHATSAPP_TEMPLATE to its name.
#  Testing: WHATSAPP_TOKEN=json prints messages to the log.
# ============================================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Country code prepended to 10-digit phone numbers (India = 91).
WHATSAPP_CC=91

# ---------- Scheduled jobs ----------
# VPS / always-on Node: leave CRON_ENABLED=true.
# Shared hosting where the process may sleep: set false and add two
# Hostinger cron jobs:
#   hourly       -> https://your-domain/cron/run?key=CRON_SECRET
#   daily 08:00  -> https://your-domain/cron/daily?key=CRON_SECRET
CRON_ENABLED=true
CRON_SECRET=replace-with-another-random-string
